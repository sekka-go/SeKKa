{
  "name": "sekka-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty",
    "test": "node --experimental-strip-types --test ../packages/domain/*.test.mjs ../supabase/tests/*.test.mjs",
    "lint": "eslint --config eslint.config.js src/v2",
    "test:domain": "node --experimental-strip-types --test ../packages/domain/*.test.mjs",
    "test:db": "node --experimental-strip-types --test ../supabase/tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "10.14.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.4"
  }
}
