# Frontend local/hosted API overrides (optional; public values only).
# Leave VITE_API_BASE_URL empty for local development with the Vite /api proxy.
VITE_API_BASE_URL=
# Supabase publishable (anon) key only. Never use a service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local Express/SQLite development server (optional).
PORT=3001
SEKKA_DB_PATH=
SEKKA_WEB_DIST=
SEKKA_ROUTING_URL=http://127.0.0.1:5000
SEKKA_VAPID_PUBLIC_KEY=
SEKKA_VAPID_PRIVATE_KEY=
SEKKA_VAPID_SUBJECT=

# Supabase Edge Function secrets are configured in Supabase, not in the browser.
# Do not copy service-role keys or provider tokens into VITE_* variables.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# SEKKA_ALLOWED_ORIGINS=
# SEKKA_VAPID_PUBLIC_KEY=
# SEKKA_VAPID_PRIVATE_KEY=
# SEKKA_VAPID_SUBJECT=
# SEKKA_ROUTING_URL=https://router.project-osrm.org
# PHOTON_API_BASE_URL=https://photon.komoot.io
# NOMINATIM_API_BASE_URL=https://nominatim.openstreetmap.org
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
